{
  "id": "sap-quantum-learning",
  "name": "SAP Quantum Learning",
  "category": "education",
  "description": "Interactive browser app teaching quantum concepts (superposition, entanglement, phase) through SAP business scenarios, with a drag-and-drop circuit composer",
  "keywords": ["sap", "education", "quantum", "circuit", "composer", "tutorial"],
  "entrypoint": {
    "type": "web-static",
    "serve_dir": "build",
    "port": 3000,
    "working_dir": "rasqberry-sap-demo"
  },
  "install": {
    "preinstalled": false,
    "repo_url": "https://github.com/Sameer-kulkarni-sk/rasqberry-sap-demo.git",
    "marker_file": "package.json"
  },
  "needs_hw": { "leds": false, "display": "required", "network": false },
  "needs_ibm_token": "none",
  "browser_based": true,
  "loop_ok": false,
  "timeout": 0,
  "icon": { "type": "system", "path": "applications-education" },
  "menu": { "show": true, "order": 70 },
  "desktop": { "show": true, "terminal": false }
}
